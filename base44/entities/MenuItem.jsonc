{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "Comida (diario)",
        "Bebidas",
        "Especiales",
        "Higiene",
        "Snacks",
        "Postres"
      ]
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "Lunes",
        "Martes",
        "Mi\u00e9rcoles",
        "Jueves",
        "Viernes"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "stock": {
      "type": "number",
      "default": 50
    },
    "prep_time": {
      "type": "string",
      "default": "5 min"
    },
    "is_combo": {
      "type": "boolean",
      "default": false
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "emoji": {
      "type": "string",
      "default": ""
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}