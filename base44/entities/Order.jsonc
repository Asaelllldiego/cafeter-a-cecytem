{
  "name": "Order",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_preparacion",
        "listo",
        "entregado",
        "cancelado"
      ],
      "default": "pendiente"
    },
    "pickup_time": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "customer_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "item_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "items",
    "total",
    "pickup_time"
  ]
}