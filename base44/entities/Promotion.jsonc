{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "accent": {
      "type": "string",
      "enum": [
        "mustard",
        "brand"
      ],
      "default": "mustard"
    }
  },
  "required": [
    "title",
    "subtitle"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}